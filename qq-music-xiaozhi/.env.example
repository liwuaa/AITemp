# 从小智控制台获取 MCP 接入点（智能体配置页 → MCP 设置 → 获取 MCP 接入点）
# 形如: wss://api.xiaozhi.me/mcp/?token=xxxx
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=请替换为你的接入点Token

# QQ Music API 端口（默认 3200）
PORT=3200

# 启用全局 Cookie（扫码登录后自动使用）
USE_GLOBAL_COOKIE=true

# 设备只播局域网 PCM：http://电脑IP:3210/proxy/pcm （不要用 CDN/HTTPS）
# 填与设备同一 WiFi 的电脑 IP；127.0.0.1 设备访问不到
MUSIC_PROXY_HOST=192.168.x.x
MUSIC_PROXY_PORT=3210

# MCP 请求缓存（毫秒）
MCP_CACHE_TTL_SEARCH=600000
MCP_CACHE_TTL_PLAY=300000
MCP_CACHE_MAX_ENTRIES=200
MCP_UPSTREAM_CONCURRENCY=4
MCP_SEARCH_LIMIT=8
MCP_RECENT_MAX=20

# 可选：跳过启动时的扫码登录检查（1=跳过）
# SKIP_QQ_LOGIN=0

# 可选：手动填写 Cookie（一般不需要，优先用扫码登录写入 config/user-info.json）
# QQMUSIC_COOKIE=

#ESP32-S3-WROOM-1-QFN56