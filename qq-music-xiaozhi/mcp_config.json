{
  "mcpServers": {
    "qq-music": {
      "type": "stdio",
      "command": "node",
      "args": [
        "./mcp/qq_music_local_mcp.mjs"
      ],
      "env": {
        "USE_GLOBAL_COOKIE": "true",
        "QQ_MUSIC_API_CONFIG_DIR": "./config",
        "MUSIC_PROXY_HOST": "127.0.0.1",
        "MUSIC_PROXY_PORT": "3210",
        "MCP_CACHE_TTL_SEARCH": "600000",
        "MCP_CACHE_TTL_PLAY": "300000",
        "MCP_CACHE_MAX_ENTRIES": "200",
        "MCP_UPSTREAM_CONCURRENCY": "4",
        "MCP_SEARCH_LIMIT": "8"
      }
    },
    "qq-music-official": {
      "disabled": true,
      "type": "stdio",
      "command": "node",
      "args": [
        "./node_modules/@sansenjian/qq-music-api-mcp/dist/cli.js"
      ],
      "env": {
        "USE_GLOBAL_COOKIE": "true",
        "QQ_MUSIC_API_CONFIG_DIR": "./config"
      }
    }
  }
}
